# Coolify Environment Variables for Taru Villas (production)
# Copy values from local .env.local. Mark the four NEXT_PUBLIC_* vars
# as "Available at Buildtime" in Coolify — they are inlined at build time.
# The Dockerfile's builder stage ARGs default to the values below where
# noted; Coolify's own value always takes precedence when Buildtime is set.

# --- build-time (REQUIRED, mark Buildtime in Coolify) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL for asset QR links and driver push deep links.
# Dockerfile ARG defaults to https://tvpl.morpheusds.com if unset here.
NEXT_PUBLIC_APP_URL=https://tvpl.morpheusds.com
# Public VAPID key, paired with the runtime VAPID_PRIVATE_KEY below. Used by
# the browser to subscribe to push (fleet driver "New trip assigned" etc).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- runtime (REQUIRED) ---
POSTGRES_URL=
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Client 1 production modules; leave unset only in the legacy internal environment.
CLIENT_ENABLED_MODULES=dashboard,tasks,surveys,fleet
# Client 1 permits only users whose profiles were created by an administrator.
# Leave unset in the legacy internal environment to retain self-service onboarding.
CLIENT_INVITE_ONLY=true
# Required when CLIENT_INVITE_ONLY=true. Set only after public sign-ups have
# been disabled in the dedicated Client 1 Supabase project.
CLIENT_SUPABASE_PUBLIC_SIGNUPS_DISABLED=true

# --- runtime (REQUIRED for Web Push — fleet driver notifications) ---
# Generate with: npx web-push generate-vapid-keys
# Must match NEXT_PUBLIC_VAPID_PUBLIC_KEY above (same keypair). Without all
# three, notify() records in-app only (deliveryError: VAPID keys not
# configured) and push is silently inert.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@taruvillas.com

# --- runtime (REQUIRED for /api/cron/* routes, incl. fleet 5pm optimize) ---
CRON_SECRET=

# --- optional (OTA feature, leave unset this round) ---
# GOOGLE_PLACES_API_KEY=
# ANTHROPIC_API_KEY=

# --- do NOT set in production ---
# DEV_BYPASS_AUTH   (dev-only auth bypass)
# VERCEL_OIDC_TOKEN (Vercel-only artifact)
